{
  "name": "banquet-steward-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 4330",
    "check": "node --check src/index.mjs && node --check src/backend-app.mjs && node --check web/app.js && node --check web/pdf-import.js",
    "test": "node --test test/*.test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {"wrangler": "4.148.0"},
  "engines": {"node": ">=24"}
}
